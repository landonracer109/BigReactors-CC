-- reactors wall: one panel each

local function drawReactor(cv, x, y, pw, ph, r)
  local colour = r.live and (r.where == "Earth" and C.lightBlue or C.orange) or C.red
  panel(cv, x, y, pw, ph, r.label .. "  (" .. r.name .. ")", colour)
  local inner = pw - 2
  local yy = y + 2
  if not r.src then
    cvWrite(cv, x + 1, yy, "No reports yet from \"" .. r.name .. "\"", C.red)
    return
  end
  local R, T = r.R, r.T
  if not r.live then
    cvWrite(cv, x + 1, yy, "NOT REPORTING for " .. duration(r.age), C.red); yy = yy + 1
    cvWrite(cv, x + 1, yy, "(last readings below)", C.grey); yy = yy + 2
  end
  local function line(key, value, c) if yy < y + ph then kv(cv, x + 1, yy, inner, key, value, c) end; yy = yy + 1 end
  local function bar(key, frac, c, label)
    if yy < y + ph then
      cvWrite(cv, x + 1, yy, key, C.lightGrey)
      cvBar(cv, x + 13, yy, inner - 12, frac, c, label)
    end
    yy = yy + 1
  end
  line("Status", R.ok and (R.active and "ONLINE" or "OFFLINE") or "not connected",
    (R.ok and R.active) and C.lime or C.red)
  line("Controller", tostring(R.control or "?"), (tostring(R.control or ""):find("WATER") or tostring(R.control or ""):find("hot")) and C.red or C.yellow)
  line("Control rods", dec(num(R.rods), 1) .. "%")
  line("Power", commas(round(num(T.rf), 100)) .. " RF/t", C.lime)
  line("Turbines", string.format("%d on / %d standby / %d off", num(T.running), num(T.standby), num(T.offline)),
    num(T.offline) > 0 and C.red or C.white)
  line("Steam", commas(round(num(R.steamMade), 10)) .. " / " .. commas(num(R.demand)) .. " mB/t")
  bar("Water", num(R.waterMax) > 0 and num(R.water) / num(R.waterMax) or 0, C.blue,
    short(num(R.water)) .. " / " .. short(num(R.waterMax)))
  bar("Steam tank", num(R.steamMax) > 0 and num(R.steam) / num(R.steamMax) or 0, C.lightGrey,
    short(num(R.steam)) .. " / " .. short(num(R.steamMax)))
  local temp = num(R.fuelTemp)
  line("Fuel temp", commas(temp) .. " C", temp > 1000 and C.red or (temp > 600 and C.yellow or C.white))
  line("Fuel burn", dec(num(R.burn), 3) .. " mB/t")
  line("Reactivity", string.format("%d%%", math.floor(num(R.reactivity) + 0.5)))
  local up = num(r.d.up)
  line("Up", string.format("%dh %02dm", math.floor(up / 3600), math.floor(up % 3600 / 60)) ..
    "   " .. tostring(r.d.v or "") .. (r.d.sha and (" " .. r.d.sha) or ""), C.grey)
end

local function drawReactors(cv, list)
  cvClear(cv, C.black)
  cvFill(cv, 1, 1, cv.w, 1, C.grey)
  cvWrite(cv, 2, 1, "REACTORS", C.white, C.grey)
  local cols = cv.w >= 80 and 2 or 1
  local rowsN = math.ceil(#list / cols)
  local pw = math.floor((cv.w - 1) / cols) - 1
  local ph = math.floor((cv.h - 2) / math.max(1, rowsN)) - 1
  for i, r in ipairs(list) do
    local col = (i - 1) % cols
    local row = math.floor((i - 1) / cols)
    drawReactor(cv, 2 + col * (pw + 1), 3 + row * (ph + 1), pw, ph, r)
  end
end

