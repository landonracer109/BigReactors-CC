-- turbines wall: small cards grouped by reactor

local CARD_W, CARD_H = 13, 4   -- width includes a one-character gap; rows of cards touch (their colour bars separate them)
local STATE = { RUNNING = { "RUN", C.green }, STANDBY = { "STBY", C.grey }, SPARE = { "SPARE", C.purple },
                ["SPIN-UP"] = { "SPIN", C.orange }, OFFLINE = { "OFF", C.red } }

local function drawCard(cv, x, y, t, live)
  local st = STATE[t.state] or { tostring(t.state or "?"):sub(1, 5), C.grey }
  local colour = (live and t.ok ~= false) and st[2] or C.red
  local cw = CARD_W - 1
  cvFill(cv, x, y, cw, CARD_H, C.black)
  cvFill(cv, x, y, cw, 1, colour)
  cvWrite(cv, x + 1, y, tostring(t.n or "?"), C.white, colour)
  local label = t.ok == false and "LOST" or st[1]
  cvWrite(cv, x + cw - 1 - #label, y, label, C.white, colour)
  if t.ok == false then
    cvWrite(cv, x + 1, y + 1, "not connected", C.red)
    return
  end
  local rpm = num(t.rpm)
  cvWrite(cv, x + 1, y + 1, commas(round(rpm, 10)) .. " rpm",
    (rpm > 2400 and rpm < 2900) and C.lime or (rpm >= 2900 and C.red or C.yellow))
  cvWrite(cv, x + 1, y + 2, num(t.rf) > 0 and (short(round(num(t.rf), 100)) .. " RF/t") or "-", C.white)
  cvBar(cv, x, y + 3, cw, num(t.buffer), C.red, "buf " .. pct(num(t.buffer)))
end

local function groupsOf(list)
  local n = 0
  for _, r in ipairs(list) do if #r.turbines > 0 then n = n + 1 end end
  return n
end

-- Lines needed. A wall showing one reactor uses its title bar for that reactor's heading.
local function turbineRows(w, list)
  local perRow = math.max(1, math.floor((w - 1) / CARD_W))
  local rows = 0
  for _, r in ipairs(list) do
    if #r.turbines > 0 then rows = rows + 2 + math.ceil(#r.turbines / perRow) * CARD_H end
  end
  return rows + (groupsOf(list) == 1 and 0 or 2)
end

local function drawTurbines(cv, list)
  cvClear(cv, C.black)
  cvFill(cv, 1, 1, cv.w, 1, C.grey)
  local single = groupsOf(list) == 1
  if not single then
    local count = 0
    for _, r in ipairs(list) do count = count + #r.turbines end
    cvWrite(cv, 2, 1, "TURBINES (" .. count .. ")", C.white, C.grey)
  end
  local perRow = math.max(1, math.floor((cv.w - 1) / CARD_W))
  local y = single and 1 or 3
  for _, r in ipairs(list) do
    if #r.turbines > 0 then
      local on, sb = num(r.T.running), num(r.T.standby)
      local head = r.label .. " TURBINES   " .. on .. " running, " .. sb .. " standby   " .. commas(round(num(r.T.rf), 100)) .. " RF/t"
      local colour = r.live and (r.where == "Earth" and C.lightBlue or C.orange) or C.red
      if single then
        cvWrite(cv, 2, y, head, C.white, C.grey)
        if not r.live then cvWrite(cv, 3 + #head, y, "  NOT REPORTING", C.white, C.red) end
        y = y + 2
      else
        cvWrite(cv, 2, y, head, colour)
        if not r.live then cvWrite(cv, 3 + #head, y, "  NOT REPORTING", C.red) end
        y = y + 1
      end
      for i, t in ipairs(r.turbines) do
        local col = (i - 1) % perRow
        local row = math.floor((i - 1) / perRow)
        drawCard(cv, 2 + col * CARD_W, y + row * CARD_H, t, r.live)
      end
      y = y + math.ceil(#r.turbines / perRow) * CARD_H + 1
    end
  end
end

