-- the walls

-- Up to four turbine walls: the reactors are shared out between however many are set up.
local TURBINE_ROLES = { "turbines", "turbines2", "turbines3", "turbines4" }
local ROLES = { "main", "reactors", "turbines", "turbines2", "turbines3", "turbines4" }
local ROLE_NAME = { main = "MAIN (total power + fuel)", reactors = "REACTORS", turbines = "TURBINES 1",
                    turbines2 = "TURBINES 2 (S if there are no more turbine walls)",
                    turbines3 = "TURBINES 3 (S if there are no more turbine walls)",
                    turbines4 = "TURBINES 4 (S if there are no more turbine walls)" }
local walls = {}   -- role -> { name, p, canvas, scaleFor }

local function loadWalls()
  local h = fs.open(WALLS_FILE, "r")
  if not h then return nil end
  local t = textutils.unserialize(h.readAll() or "")
  h.close()
  return type(t) == "table" and t or nil
end

-- Asks which monitor is which wall: each monitor says "touch me", and the touches are taken in order.
local function setup()
  local mons = {}
  for _, name in ipairs(peripheral.getNames()) do
    if peripheral.getType(name) == "monitor" then mons[#mons + 1] = name end
  end
  if #mons == 0 then
    print("No monitors connected. Connect the walls with wired modems (right-click them so they")
    print("turn red) and networking cable, then run this again.")
    return nil
  end
  local chosen, taken = {}, {}
  local noMoreTurbines = false
  for _, role in ipairs(ROLES) do
    -- every monitor already has a job, or a turbine wall was skipped: no more turbine walls
    local free = 0
    for _, name in ipairs(mons) do if not taken[name] then free = free + 1 end end
    if role:find("^turbines") and (noMoreTurbines or free == 0) then break end
    for _, name in ipairs(mons) do
      local m = peripheral.wrap(name)
      m.setTextScale(1)
      m.setBackgroundColour(colours.black)
      m.clear()
      m.setCursorPos(2, 2)
      if taken[name] then
        m.setTextColour(colours.grey)
        m.write("This is the " .. taken[name] .. " wall.")
      else
        m.setTextColour(colours.yellow)
        m.write("Touch the wall for: " .. ROLE_NAME[role])
      end
    end
    print("Touch the monitor wall for " .. ROLE_NAME[role] .. "  (or press S to skip it)")
    while true do
      local e, p1 = os.pullEvent()
      if e == "monitor_touch" and not taken[p1] then
        chosen[role], taken[p1] = p1, role:upper()
        print("  " .. role .. " = " .. p1)
        break
      elseif e == "key" and p1 == keys.s then
        print("  " .. role .. " skipped")
        if role:find("^turbines") then noMoreTurbines = true end
        break
      end
    end
  end
  local h = fs.open(WALLS_FILE, "w")
  h.write(textutils.serialize(chosen))
  h.close()
  for _, name in ipairs(mons) do pcall(function() local m = peripheral.wrap(name); m.clear() end) end
  return chosen
end

-- Each wall gets the biggest text that still fits what it has to show.
local FITS = {
  main = function(w, h, list) return w >= 64 and h >= 22 + #list end,
  reactors = function(w, h, list)
    local cols = w >= 80 and 2 or 1
    return w >= 40 and math.floor((h - 2) / math.ceil(#list / cols)) - 1 >= 15
  end,
  turbines = function(w, h, list) return w >= 2 * CARD_W + 1 and turbineRows(w, list) <= h end,
}
local DRAW = { main = drawMain, reactors = drawReactors }
for _, r in ipairs(TURBINE_ROLES) do DRAW[r] = drawTurbines; FITS[r] = FITS.turbines end

local function fitKey(role, list)
  if role == "main" or role == "reactors" then return #list end
  local parts = {}
  for _, r in ipairs(list) do parts[#parts + 1] = #r.turbines end
  return table.concat(parts, ",")
end

-- With several turbine walls, the reactors are shared out between them in order, each reactor's
-- turbines kept together, so each wall holds about the same number (with as many walls as
-- reactors: one reactor each, which leaves room for bigger text).
local function turbineShare(role, list)
  local present, mine = {}, nil
  for _, r in ipairs(TURBINE_ROLES) do
    if walls[r] then
      present[#present + 1] = r
      if r == role then mine = #present end
    end
  end
  local n = #present
  if n <= 1 or not mine then return list end
  local total = 0
  for _, r in ipairs(list) do total = total + #r.turbines end
  if total == 0 then return mine == 1 and list or {} end
  local part, before = {}, 0
  for _, r in ipairs(list) do
    -- the wall a reactor goes to is set by where the middle of its turbines falls
    local wall = math.min(n, math.floor((before + #r.turbines / 2) / total * n) + 1)
    if wall == mine then part[#part + 1] = r end
    before = before + #r.turbines
  end
  return part
end

local function drawWall(role, list)
  local wall = walls[role]
  if not wall then return end
  if role:find("^turbines") then list = turbineShare(role, list) end
  local ok = pcall(function()
    local p = wall.p
    local key = fitKey(role, list)
    local w, h = p.getSize()
    if not wall.canvas or wall.canvas.w ~= w or wall.canvas.h ~= h or wall.key ~= key then
      local scale = 5
      while true do
        p.setTextScale(scale)
        local tw, th = p.getSize()
        if scale <= 0.5 or FITS[role](tw, th, list) then break end
        scale = scale - 0.5
      end
      w, h = p.getSize()
      wall.canvas = newCanvas(w, h, p.isColour and p.isColour() or false)
      wall.key = key
      p.setBackgroundColour(colours.black)
      p.clear()
    end
    DRAW[role](wall.canvas, list)
    cvFlush(wall.canvas, p)
  end)
  if not ok then wall.canvas = nil end
end

local function connectWalls(names)
  walls = {}
  for _, role in ipairs(ROLES) do
    local name = names[role]
    if name and peripheral.getType(name) == "monitor" then
      walls[role] = { name = name, p = peripheral.wrap(name) }
    end
  end
end

local function drawTerminal(list)
  term.setBackgroundColour(colours.black)
  term.clear()
  term.setCursorPos(1, 1)
  print("dashboard - reading " .. RELAY)
  print("")
  print("Relay: " .. freshness(list))
  for _, r in ipairs(list) do
    print(string.format("  %-8s %s", r.label, not r.src and "no reports yet" or
      (r.live and (commas(round(num(r.T.rf), 100)) .. " RF/t") or "NOT REPORTING")))
  end
  print("")
  for _, role in ipairs(ROLES) do
    print(string.format("%-9s wall: %s", role, walls[role] and walls[role].name or "not connected"))
  end
  print("")
  print("Q to stop. \"dashboard setup\" picks the walls again.")
end

---------------------------------------------------------------------------------------------------
-- main loop

if not http then
  print("The http API is off on this server.")
  return
end

local names = (args[1] ~= "setup") and loadWalls() or nil
if not names then
  names = setup()
  if not names then return end
end
connectWalls(names)

startRead()
local timer = os.startTimer(0.5)
while true do
  local event, p1, p2 = os.pullEventRaw()
  if event == "http_success" or event == "http_failure" then
    if readDone(event, p1, p2) then
      local list = reactors()
      for _, role in ipairs(ROLES) do drawWall(role, list) end
      drawTerminal(list)
    end
  elseif event == "timer" and p1 == timer then
    startRead()
    if relayProblem or not status then
      local list = reactors()
      for _, role in ipairs(ROLES) do drawWall(role, list) end
      drawTerminal(list)
    end
    timer = os.startTimer(REFRESH)
  elseif event == "peripheral" or event == "peripheral_detach" or event == "monitor_resize" then
    connectWalls(names)
  elseif (event == "key" and p1 == keys.q) or event == "terminate" then
    term.clear(); term.setCursorPos(1, 1)
    print("dashboard stopped.")
    return
  end
end
