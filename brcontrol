-- brcontrol: controls an actively cooled Big Reactors reactor and its turbines, with a dashboard.
-- ComputerCraft 1.63 + Big Reactors 0.3.4.
--
-- Setup: connect the reactor's Computer Port, every turbine's Computer Port and the monitors to
-- this computer with networking cable and wired modems (right-click each modem so it turns red).
-- Save this as "startup" so it starts again after a server restart.
--
-- The reactor's control rods are set so it makes as much steam as the running turbines use.
-- Turbines spin up with their coils off, then run with coils on. If the turbines' power buffers
-- fill up (nothing is using the power), turbines are stood down one at a time, and brought back
-- when the power is needed again.

local VERSION = "v4"

local CFG = {
  turbineFlow   = 2000,  -- mB/t of steam each running turbine takes
  coilsOffBelow = 1800,  -- RPM: below this the coils are disengaged so the rotor spins up faster
  coilsOnAbove  = 2400,  -- RPM: at or above this the coils are engaged
  bufferHigh    = 0.95,  -- a turbine whose power buffer is this full stands down (its power has nowhere to go)
  bufferLow     = 0.50,  -- it comes back when its buffer drops below this
  standDownWait = 20,    -- at most one turbine stands down per this many seconds
  steamPerRod   = 4000,  -- roughly how many mB/t of steam 1% of control rod changes (measured on the 16x16x14 reactor)
  control       = 2,     -- seconds between control rod adjustments (3 reactor reads each)
  update        = 6,     -- seconds between turbine reads and dashboard redraws (a multiple of control)
  textScale     = 0,     -- monitor text size 0.5-5; 0 = the biggest that fits
  monitorOrder  = { "right", "monitor_6", "monitor_4", "monitor_5" },  -- empty {} = by name.
                         -- The first is the overview, the rest show the turbines.
}

---------------------------------------------------------------------------------------------------
-- helpers

local function clamp(v, lo, hi) if v < lo then return lo elseif v > hi then return hi end return v end

local function commas(n)
  local s = tostring(math.floor(math.abs(n) + 0.5))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  if out:sub(1, 1) == "," then out = out:sub(2) end
  return (n < 0 and "-" or "") .. out
end

-- n with `places` decimals. (ComputerCraft 1.63's string.format ignores "%.2f" precision.)
local function dec(n, places)
  local scale = 10 ^ places
  local v = math.floor(math.abs(n) * scale + 0.5)
  local whole = math.floor(v / scale)
  local frac = tostring(v - whole * scale)
  frac = string.rep("0", places - #frac) .. frac
  return (n < 0 and v > 0 and "-" or "") .. commas(whole) .. (places > 0 and ("." .. frac) or "")
end

local function short(n)
  local a = math.abs(n)
  if a >= 1e9 then return dec(n / 1e9, 2) .. "G" end
  if a >= 1e6 then return dec(n / 1e6, 2) .. "M" end
  if a >= 1e4 then return dec(n / 1e3, 1) .. "k" end
  return commas(n)
end

local function pct(f) return string.format("%d%%", math.floor(clamp(f, 0, 9.99) * 100 + 0.5)) end

-- Rounded for display, so small wobbles do not make the monitors redraw.
local function round(n, step) return math.floor(n / step + 0.5) * step end

-- Calls a peripheral method; returns nil instead of failing (a machine can be unloaded or broken).
local function try(p, method, ...)
  if not p then return nil end
  local ok, v = pcall(p[method], ...)
  if ok then return v end
  return nil
end

local function num(v) return tonumber(v) or 0 end

---------------------------------------------------------------------------------------------------
-- peripherals

local reactor, reactorName
local turbines = {}   -- { name, p, label, state fields... }
local monitors = {}   -- { name, p, canvas }
local tanks = {}      -- { name, p } fluid tanks read through OpenPeripherals
local storage = {}    -- fluid name -> { amount, capacity, count }
local rodCount = 0
local rodCache = {}

local function naturalLess(a, b)
  local pa, na = a:match("^(.-)(%d*)$")
  local pb, nb = b:match("^(.-)(%d*)$")
  if pa ~= pb then return pa < pb end
  return (tonumber(na) or -1) < (tonumber(nb) or -1)
end

-- Big Reactors 0.3.4's getNumberOfControlRods returns the number of fuel rod blocks, and a rod
-- index past the end throws, so count the control rods by asking for each one in turn.
local function countRods()
  local n = 0
  while n < 1000 and pcall(reactor.getControlRodLevel, n) do n = n + 1 end
  return n
end

local function scan()
  local names = peripheral.getNames()
  table.sort(names, naturalLess)
  local oldTurbines = {}
  for _, t in ipairs(turbines) do oldTurbines[t.name] = t end
  local newReactor, newReactorName
  turbines = {}
  tanks = {}
  local mons = {}
  for _, name in ipairs(names) do
    local kind = peripheral.getType(name)
    if kind == "BigReactors-Reactor" and not newReactor then
      newReactor, newReactorName = peripheral.wrap(name), name
    elseif kind == "BigReactors-Turbine" then
      local t = oldTurbines[name] or { name = name, standby = false, spunUp = false }
      t.p = peripheral.wrap(name)
      if not t.ventSet then
        -- "Vent overflow" (Big Reactors' default): if the water can't go back fast enough, the
        -- extra is vented instead of the turbine stopping. "Do not vent" can stall turbines.
        t.ventSet = pcall(t.p.setVentOverflow)
      end
      turbines[#turbines + 1] = t
      t.label = "T" .. #turbines
    elseif kind == "monitor" then
      mons[#mons + 1] = name
    elseif kind then
      -- Tanks (Thermal Expansion portable tanks, drums...) are readable through OpenPeripherals'
      -- getTankInfo. Any tank on the network is shown in the storage panel.
      local methods = peripheral.getMethods(name) or {}
      for _, m in ipairs(methods) do
        if m == "getTankInfo" then tanks[#tanks + 1] = { name = name, p = peripheral.wrap(name) }; break end
      end
    end
  end
  if newReactorName ~= reactorName then
    reactor, reactorName = newReactor, newReactorName
    rodCache = {}
    rodCount = reactor and countRods() or 0
  end
  -- monitors: configured order first, then the rest by name
  local ordered, used = {}, {}
  for _, name in ipairs(CFG.monitorOrder) do
    if peripheral.getType(name) == "monitor" then ordered[#ordered + 1] = name; used[name] = true end
  end
  for _, name in ipairs(mons) do if not used[name] then ordered[#ordered + 1] = name end end
  local oldMons = {}
  for _, m in ipairs(monitors) do oldMons[m.name] = m end
  monitors = {}
  for _, name in ipairs(ordered) do
    local m = oldMons[name] or { name = name }
    m.p = peripheral.wrap(name)
    monitors[#monitors + 1] = m
  end
end

---------------------------------------------------------------------------------------------------
-- reading

local R = { ok = false }   -- reactor readings

-- The three readings the rod controller needs; every CFG.control seconds.
local function readReactorFast()
  if not reactor then R.ok = false; return end
  local made = try(reactor, "getHotFluidProducedLastTick")
  if made == nil then R.ok = false; return end
  R.ok = true
  R.steamMade = num(made)
  R.steam = math.max(0, num(try(reactor, "getHotFluidAmount")))
  R.water = num(try(reactor, "getCoolantAmount"))
end

-- Everything else, for the dashboard; every CFG.update seconds.
local function readReactorSlow()
  if not R.ok then return end
  R.active = try(reactor, "getActive") and true or false
  R.cooled = try(reactor, "isActivelyCooled") and true or false
  R.fuelTemp = num(try(reactor, "getFuelTemperature"))
  R.caseTemp = num(try(reactor, "getCasingTemperature"))
  R.fuel = num(try(reactor, "getFuelAmount"))
  R.fuelMax = num(try(reactor, "getFuelAmountMax"))
  R.waste = num(try(reactor, "getWasteAmount"))
  R.burn = num(try(reactor, "getFuelConsumedLastTick"))
  R.reactivity = num(try(reactor, "getFuelReactivity"))
  R.waterMax = num(try(reactor, "getCoolantAmountMax"))
  R.steamMax = num(try(reactor, "getHotFluidAmountMax"))
end

-- Adds up every connected tank by fluid. OpenPeripherals returns a list of tanks, each
-- { capacity, amount, name, rawName, ... } (no fluid fields when empty).
local function readStorage()
  storage = {}
  for _, tank in ipairs(tanks) do
    local info = try(tank.p, "getTankInfo", "unknown")
    if type(info) == "table" then
      for _, t in pairs(info) do
        if type(t) == "table" then
          local fluid = tostring(t.rawName or t.name or "empty")
          if (tonumber(t.amount) or 0) <= 0 then fluid = "empty" end
          local key = fluid:lower()
          local s = storage[key] or { label = fluid, amount = 0, capacity = 0, count = 0 }
          s.amount = s.amount + (tonumber(t.amount) or 0)
          s.capacity = s.capacity + (tonumber(t.capacity) or 0)
          s.count = s.count + 1
          storage[key] = s
        end
      end
    end
  end
end

-- Four readings per turbine. Its on/off, coils and flow setting only change when this program
-- changes them, so those are read again just once a minute (in case someone used the GUI).
local function readTurbine(t, full)
  local p = t.p
  local rpm = try(p, "getRotorSpeed")
  t.ok = rpm ~= nil
  if not t.ok then t.settingsKnown = false; return end
  t.rpm = num(rpm)
  t.rf = num(try(p, "getEnergyProducedLastTick"))
  t.flow = num(try(p, "getFluidFlowRate"))
  t.buffer = num(try(p, "getEnergyStored")) / 1000000
  if full or not t.settingsKnown then
    t.active = try(p, "getActive") and true or false
    t.coils = try(p, "getInductorEngaged") and true or false
    t.flowMax = num(try(p, "getFluidFlowRateMax"))
    t.settingsKnown = true
  end
end

-- Changes a turbine setting and remembers it, so it doesn't have to be read back.
local function setTurbine(t, method, field, value)
  if pcall(t.p[method], value) then t[field] = value end
end

---------------------------------------------------------------------------------------------------
-- control

local rods = nil          -- wanted control rod insertion, 0-100 (fractions are spread over the rods)
local demand = 0
local controlNote = ""
local lastStandChange = -1000

-- Sets the rods so their average is `level`: some rods one step further in than the others.
local function applyRods(level)
  if rodCount == 0 then return end
  local base = math.floor(level)
  local extra = math.floor((level - base) * rodCount + 0.5)
  for i = 0, rodCount - 1 do
    local want = math.min(100, base + ((i < extra) and 1 or 0))
    if rodCache[i] ~= want then
      if pcall(reactor.setControlRodLevel, i, want) then rodCache[i] = want else rodCache[i] = nil end
    end
  end
end

local function controlTurbines(now)
  local running, sum, n = 0, 0, 0
  for _, t in ipairs(turbines) do
    if t.ok then n = n + 1; sum = sum + t.buffer end
  end
  local avgBuffer = n > 0 and sum / n or 0

  -- Each turbine on its own: one whose power buffer is full can't send its power anywhere, so
  -- its steam would be wasted. It stands down, and comes back when its buffer has drained
  -- (a Tesseract drains senders one after another, not evenly). At most one turbine stands down
  -- per CFG.standDownWait seconds, so the reactor eases down instead of dropping all at once.
  for _, t in ipairs(turbines) do
    if t.ok and t.standby and t.buffer < CFG.bufferLow then t.standby = false end
  end
  if now - lastStandChange >= CFG.standDownWait then
    local fullest
    for _, t in ipairs(turbines) do
      if t.ok and not t.standby and t.buffer >= CFG.bufferHigh and (not fullest or t.buffer > fullest.buffer) then
        fullest = t
      end
    end
    if fullest then fullest.standby = true; lastStandChange = now end
  end

  -- A reactor's steam tank holds 50,000 mB at most, and it can't boil more than that per tick.
  -- Turbines past what it can feed are kept as spares, so the rest get full steam.
  local maxRunning = math.huge
  if R.ok and R.steamMax > 0 then maxRunning = math.floor(R.steamMax / CFG.turbineFlow) end

  demand = 0
  for _, t in ipairs(turbines) do
    if t.ok then
      local spare = not t.standby and running >= maxRunning
      if t.standby or spare then
        if t.active then setTurbine(t, "setActive", "active", false) end
        if t.coils then setTurbine(t, "setInductorEngaged", "coils", false) end
        t.state = spare and "SPARE" or "STANDBY"
      else
        if not t.active then setTurbine(t, "setActive", "active", true) end
        if t.flowMax ~= CFG.turbineFlow then setTurbine(t, "setFluidFlowRateMax", "flowMax", CFG.turbineFlow) end
        if t.rpm >= CFG.coilsOnAbove then t.spunUp = true
        elseif t.rpm < CFG.coilsOffBelow then t.spunUp = false end
        if t.spunUp ~= t.coils then setTurbine(t, "setInductorEngaged", "coils", t.spunUp) end
        t.state = t.spunUp and "RUNNING" or "SPIN-UP"
        demand = demand + CFG.turbineFlow
        running = running + 1
      end
    else
      t.state = "OFFLINE"
    end
  end
  return running, avgBuffer
end

local lastSurplus = nil
local lastWant = nil       -- steam wanted at the last update
local settleUntil = 0      -- no controller steps until then (after a turbine starts or stops)

local function controlReactor()
  if not R.ok then controlNote = "Reactor not connected"; return end
  if not R.cooled then controlNote = "Passive reactor: not controlling"; return end
  if rods == nil then
    rods = num(try(reactor, "getControlRodLevel", 0))
  end
  if demand <= 0 then
    rods = 100
    lastSurplus = nil
    lastWant = 0
    controlNote = "No turbines: rods in"
  else
    -- How much more (+) or less (-) steam the reactor makes than the turbines take, in mB/t.
    local want = math.min(demand, R.steamMax > 0 and R.steamMax or demand)
    local now = os.clock()
    -- A turbine started or stood down: move the rods by the expected amount straight away, then
    -- give the reactor a few seconds to respond before the controller takes over again.
    if lastWant and want ~= lastWant then
      rods = clamp(rods + (lastWant - want) / CFG.steamPerRod, 0, 100)
      lastSurplus = nil
      settleUntil = now + 3 * CFG.control
    end
    lastWant = want
    local surplus = R.steamMade - want
    -- The reactor pushes all its steam to the turbines every tick, so steam still in its tank is
    -- steam the turbines couldn't take: it's making more than they use, even when the "made"
    -- figure is held down by the full tanks.
    surplus = surplus + math.min(R.steam, want * 0.5)
    -- At the tank limit the reactor may have more heat than it can boil: ease the rods in until
    -- it drops below the limit, then the controller brings it back.
    if R.steamMax > 0 and want >= R.steamMax and R.steamMade >= R.steamMax * 0.998 then
      surplus = surplus + want * 0.02
    end
    -- PI controller in velocity form: react to the change in surplus (P) plus a slow push on the
    -- surplus itself (I). Gentle enough for a reactor that takes 20+ seconds to respond.
    local prev = lastSurplus or surplus
    local step = clamp((0.5 * (surplus - prev) + 0.05 * CFG.control * surplus) / CFG.steamPerRod, -2, 2)
    lastSurplus = surplus
    if now < settleUntil then step = 0 end
    local water = R.waterMax > 0 and R.water / R.waterMax or 0
    if water < 0.05 then
      step = 1
      controlNote = "OUT OF WATER: rods in"
    elseif water < 0.2 and step < 0 then
      step = 0
      controlNote = "LOW WATER: holding"
    elseif demand > want then
      controlNote = "At " .. short(R.steamMax) .. " mB/t limit"
    else
      controlNote = surplus < -want * 0.02 and "Raising steam" or
                    surplus > want * 0.02 and "Lowering steam" or "Steady"
    end
    rods = clamp(rods + step, 0, 100)
  end
  applyRods(rods)
  if demand > 0 and not R.active then try(reactor, "setActive", true) end
end

