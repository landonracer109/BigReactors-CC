-- main loop

local lastUpdate, lastFullRead, avgBuffer = -1000, -1000, 0

-- Every CFG.control seconds: 3 reactor reads and the rod controller. Every CFG.update seconds
-- also: the turbines (4 reads each), tanks, the rest of the reactor, and the dashboard.
local function tick(now)
  readReactorFast()
  local slow = now - lastUpdate >= CFG.update - 0.01
  if slow then
    lastUpdate = now
    readReactorSlow()
    local full = now - lastFullRead >= 60
    if full then lastFullRead = now end
    for _, t in ipairs(turbines) do readTurbine(t, full) end
    readStorage()
    local _
    _, avgBuffer = controlTurbines(now)
  end
  controlReactor()
  if not slow then return end

  totals = { rf = 0, flow = 0, rpm = 0, running = 0, standby = 0, offline = 0, buffer = avgBuffer }
  local spinning = 0
  for _, t in ipairs(turbines) do
    if t.ok then
      totals.rf = totals.rf + t.rf
      totals.flow = totals.flow + t.flow
      if t.state == "STANDBY" or t.state == "SPARE" then totals.standby = totals.standby + 1 else
        totals.running = totals.running + 1
        totals.rpm = totals.rpm + t.rpm
        spinning = spinning + 1
      end
    else
      totals.offline = totals.offline + 1
    end
  end
  totals.rpm = spinning > 0 and totals.rpm / spinning or 0
  if now - lastHistory >= historyEvery then
    history[#history + 1] = totals.rf
    if #history > 400 then table.remove(history, 1) end
    lastHistory = now
  end
  drawAll()
  drawTerminal()
end

scan()
local rescanAt = os.clock() + 60
local timer = os.startTimer(0)
while true do
  local event, p1 = os.pullEventRaw()
  if event == "timer" and p1 == timer then
    local now = os.clock()
    -- Look for added or removed machines once a minute (and when a modem reports a change).
    if now >= rescanAt then pcall(scan); rescanAt = now + 60 end
    local ok, err = pcall(tick, now)
    if not ok then
      term.setCursorPos(1, 18)
      term.setTextColour(colours.red)
      term.write("Error: " .. tostring(err))
      term.setTextColour(colours.white)
    end
    timer = os.startTimer(CFG.control)
  elseif event == "peripheral" or event == "peripheral_detach" or event == "monitor_resize" then
    rescanAt = os.clock()
  elseif event == "key" and p1 == keys.q then
    term.clear(); term.setCursorPos(1, 1)
    print("brcontrol stopped.")
    return
  elseif event == "terminate" then
    term.clear(); term.setCursorPos(1, 1)
    print("brcontrol stopped.")
    return
  end
end
