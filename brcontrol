-- dashboard content

local history = {}          -- total RF/t samples
local historyEvery = 60     -- seconds per sample (the graph moves once a minute)
local lastHistory = -1000
local startTime = os.clock()
local totals = {}

local function panel(cv, x, y, w, h, title)
  cvFill(cv, x, y, w, h, C.black)
  cvFill(cv, x, y, w, 1, C.blue)
  cvWrite(cv, x + 1, y, title, C.white, C.blue)
end

local function kv(cv, x, y, w, key, value, colour)
  cvWrite(cv, x, y, key, C.lightGrey)
  cvWrite(cv, x + w - #value, y, value, colour or C.white)
end

local function drawOverview(cv)
  cvClear(cv, C.black)
  local w, h = cv.w, cv.h
  cvFill(cv, 1, 1, w, 1, C.grey)
  cvWrite(cv, 2, 1, "REACTOR + TURBINES  " .. VERSION, C.white, C.grey)
  local up = os.clock() - startTime
  local clock = string.format("up %dh %02dm", math.floor(up / 3600), math.floor(up % 3600 / 60))
  cvWrite(cv, w - #clock, 1, clock, C.white, C.grey)

  local half = math.floor((w - 3) / 2)
  local lx, rx = 2, 3 + half
  local inner = half - 2

  -- reactor panel
  panel(cv, lx, 3, half, 21, "REACTOR")
  local y = 5
  if not R.ok then
    cvWrite(cv, lx + 1, y, "Not connected", C.red)
  else
    local status = R.active and "ONLINE" or "OFFLINE"
    kv(cv, lx + 1, y, inner, "Status", status, R.active and C.lime or C.red); y = y + 1
    kv(cv, lx + 1, y, inner, "Cooling", R.cooled and "active (steam)" or "passive", R.cooled and C.lime or C.orange); y = y + 1
    kv(cv, lx + 1, y, inner, "Control rods", dec(rods or 0, 1) .. "%  (" .. rodCount .. " rods)"); y = y + 1
    kv(cv, lx + 1, y, inner, "Controller", controlNote, C.yellow); y = y + 2
    kv(cv, lx + 1, y, inner, "Steam made", commas(round(R.steamMade, 10)) .. " mB/t"); y = y + 1
    kv(cv, lx + 1, y, inner, "Turbines want", commas(demand) .. " mB/t"); y = y + 1
    cvWrite(cv, lx + 1, y, "Water", C.lightGrey)
    cvBar(cv, lx + 14, y, inner - 13, R.waterMax > 0 and R.water / R.waterMax or 0, C.blue,
      short(R.water) .. " / " .. short(R.waterMax)); y = y + 1
    cvWrite(cv, lx + 1, y, "Steam tank", C.lightGrey)
    cvBar(cv, lx + 14, y, inner - 13, R.steamMax > 0 and R.steam / R.steamMax or 0, C.lightGrey,
      short(R.steam) .. " / " .. short(R.steamMax)); y = y + 2
    kv(cv, lx + 1, y, inner, "Fuel temp", commas(R.fuelTemp) .. " C"); y = y + 1
    kv(cv, lx + 1, y, inner, "Casing temp", commas(R.caseTemp) .. " C"); y = y + 1
    cvWrite(cv, lx + 1, y, "Fuel", C.lightGrey)
    cvBar(cv, lx + 14, y, inner - 13, R.fuelMax > 0 and R.fuel / R.fuelMax or 0, C.yellow,
      short(R.fuel) .. " mB  " .. pct(R.fuelMax > 0 and R.fuel / R.fuelMax or 0)); y = y + 1
    kv(cv, lx + 1, y, inner, "Waste", commas(R.waste) .. " mB"); y = y + 1
    kv(cv, lx + 1, y, inner, "Fuel burn", dec(R.burn, 3) .. " mB/t"); y = y + 1
    kv(cv, lx + 1, y, inner, "Ingots per minute", dec(R.burn * 1.2, 2)); y = y + 1
    kv(cv, lx + 1, y, inner, "Reactivity", string.format("%d%%", math.floor(R.reactivity + 0.5)))
  end

  -- totals panel
  panel(cv, rx, 3, half, 21, "POWER")
  local bigRF = commas(round(totals.rf or 0, 100))
  cvBig(cv, rx + 2, 5, bigRF, C.lime)
  cvWrite(cv, rx + 2, 10, "RF/t", C.lime)
  y = 12
  kv(cv, rx + 1, y, inner, "Turbines", string.format("%d on / %d standby / %d off",
    totals.running or 0, totals.standby or 0, totals.offline or 0)); y = y + 1
  kv(cv, rx + 1, y, inner, "Steam used", commas(totals.flow or 0) .. " mB/t"); y = y + 1
  kv(cv, rx + 1, y, inner, "Average RPM", commas(round(totals.rpm or 0, 10))); y = y + 1
  kv(cv, rx + 1, y, inner, "RF per mB steam", dec((totals.flow or 0) > 0 and totals.rf / totals.flow or 0, 2)); y = y + 1
  local perIngot = (R.burn or 0) > 0 and (totals.rf or 0) / R.burn * 1000 or 0
  kv(cv, rx + 1, y, inner, "RF per ingot", perIngot > 0 and short(perIngot) or "-"); y = y + 1
  cvWrite(cv, rx + 1, y, "Buffers", C.lightGrey)
  cvBar(cv, rx + 14, y, inner - 13, totals.buffer or 0, C.red, pct(totals.buffer or 0)); y = y + 2
  cvWrite(cv, rx + 1, y, "Peripheral: " .. (reactorName or "-"), C.grey)

  -- storage: connected tanks, added up by fluid (water and steam first)
  local keys = {}
  for k in pairs(storage) do keys[#keys + 1] = k end
  local order = { water = 1, steam = 2, empty = 99 }
  table.sort(keys, function(a, b) return (order[a] or 50) < (order[b] or 50) or ((order[a] or 50) == (order[b] or 50) and a < b) end)
  local sy = 25
  local sh = math.max(1, #keys) + 2
  panel(cv, lx, sy, w - 2, sh, string.format("STORAGE (%d tank%s)", #tanks, #tanks == 1 and "" or "s"))
  if #keys == 0 then
    cvWrite(cv, lx + 1, sy + 1, "No tanks connected", C.grey)
  end
  for i, k in ipairs(keys) do
    local s = storage[k]
    local barColour = k == "water" and C.blue or k == "steam" and C.lightGrey or C.cyan
    local label = k == "empty" and "Empty tanks" or s.label
    cvWrite(cv, lx + 1, sy + i, label, C.lightGrey)
    local text = k == "empty" and (commas(s.capacity) .. " mB free in " .. s.count .. " tank" .. (s.count == 1 and "" or "s"))
      or (commas(s.amount) .. " / " .. commas(s.capacity) .. " mB  " .. pct(s.capacity > 0 and s.amount / s.capacity or 0))
    cvBar(cv, lx + 16, sy + i, w - 20, s.capacity > 0 and s.amount / s.capacity or 0, barColour, text)
  end

  -- history graph of total RF/t
  local gy = sy + sh + 1
  local gh = h - gy - 1
  if gh >= 5 then
    panel(cv, lx, gy, w - 2, gh + 1, string.format("TOTAL RF/t, last %d min", math.floor((w - 4) * historyEvery / 60)))
    local maxv = 1
    for _, v in ipairs(history) do if v > maxv then maxv = v end end
    cvWrite(cv, w - 2 - #short(maxv), gy, short(maxv), C.white, C.blue)
    local gw = w - 4
    local first = math.max(1, #history - gw + 1)
    for i = first, #history do
      local col = lx + 1 + (i - first)
      local bar = math.floor(history[i] / maxv * (gh - 1) + 0.5)
      cvFill(cv, col, gy + gh - bar, 1, bar, C.green)
    end
  end
  cvWrite(cv, 2, h, cv.name or "", C.grey)
end

local CARD_W, CARD_H = 27, 7

local function drawCard(cv, x, y, t)
  local stateColour = ({ RUNNING = C.green, ["SPIN-UP"] = C.orange, STANDBY = C.grey, SPARE = C.purple, OFFLINE = C.red })[t.state] or C.grey
  cvFill(cv, x, y, CARD_W - 1, CARD_H - 1, C.black)
  cvFill(cv, x, y, CARD_W - 1, 1, stateColour)
  cvWrite(cv, x + 1, y, t.label, C.white, stateColour)
  cvWrite(cv, x + CARD_W - 2 - #(t.state or ""), y, t.state or "", C.white, stateColour)
  if not t.ok then
    cvWrite(cv, x + 1, y + 2, "not connected", C.red)
    cvWrite(cv, x + 1, y + 3, t.name, C.grey)
    return
  end
  local rpmColour = (t.rpm > 2400 and t.rpm < 2900) and C.lime or (t.rpm > 2900 and C.red or C.yellow)
  kv(cv, x + 1, y + 1, CARD_W - 3, "RPM", commas(round(t.rpm, 10)), rpmColour)
  kv(cv, x + 1, y + 2, CARD_W - 3, "RF/t", commas(round(t.rf, 100)))
  kv(cv, x + 1, y + 3, CARD_W - 3, "Steam", commas(t.flow) .. "/" .. commas(t.flowMax) .. " mB/t")
  kv(cv, x + 1, y + 4, CARD_W - 3, "Coils", t.coils and "ON" or "OFF", t.coils and C.lime or C.orange)
  cvWrite(cv, x + 1, y + 5, "Buf", C.lightGrey)
  cvBar(cv, x + 5, y + 5, CARD_W - 7, t.buffer, C.red, pct(t.buffer))
end

local function drawTurbines(cv, list, title)
  cvClear(cv, C.black)
  cvFill(cv, 1, 1, cv.w, 1, C.grey)
  cvWrite(cv, 2, 1, title, C.white, C.grey)
  local perRow = math.max(1, math.floor((cv.w - 1) / CARD_W))
  for i, t in ipairs(list) do
    local col = (i - 1) % perRow
    local row = math.floor((i - 1) / perRow)
    drawCard(cv, 2 + col * CARD_W, 3 + row * CARD_H, t)
  end
  cvWrite(cv, 2, cv.h, cv.name or "", C.grey)
end

local function cardsFit(w, h)
  return math.floor((w - 1) / CARD_W) * math.floor((h - 3) / CARD_H)
end

-- Sets up a monitor's canvas. The text size is the biggest that still fits (fits(w, h)), or
-- CFG.textScale if set. It's only changed on a new or changed monitor (or when `key`, what it has
-- to fit, changes): the program only redraws what changed, so it must not reset a screen that is
-- already showing the dashboard.
local function setupCanvas(m, fits, key)
  local ok = pcall(function()
    local w, h = m.p.getSize()
    if not m.canvas or m.canvas.w ~= w or m.canvas.h ~= h or m.fitKey ~= key then
      if m.p.setTextScale then
        if CFG.textScale > 0 then
          m.p.setTextScale(CFG.textScale)
        else
          local scale = 5
          while true do
            m.p.setTextScale(scale)
            local tw, th = m.p.getSize()
            if scale <= 0.5 or fits(tw, th) then break end
            scale = scale - 0.5
          end
        end
      end
      w, h = m.p.getSize()
      local colour = m.p.isColour and m.p.isColour() or false
      m.canvas = newCanvas(w, h, colour)
      m.canvas.name = m.name
      m.fitKey = key
      m.p.setBackgroundColour(colours.black)
      m.p.clear()
    end
  end)
  if not ok then m.canvas = nil end
  return ok
end

local function drawAll()
  if #monitors == 0 then return end
  local turbineMons = {}
  for i = 2, #monitors do turbineMons[#turbineMons + 1] = monitors[i] end
  -- the turbines are spread evenly over the turbine monitors
  local share = #turbineMons > 0 and math.max(1, math.ceil(#turbines / #turbineMons)) or 0

  local first = monitors[1]
  setupCanvas(first, function(w, h) return w >= 80 and h >= 30 end, "overview")
  if first.canvas then
    drawOverview(first.canvas)
    if not pcall(cvFlush, first.canvas, first.p) then first.canvas = nil end
  end

  local index = 1
  for _, m in ipairs(turbineMons) do
    setupCanvas(m, function(w, h) return cardsFit(w, h) >= share end, share)
    if m.canvas then
      local cv = m.canvas
      local count = math.min(cardsFit(cv.w, cv.h), share)
      local list = {}
      for i = index, math.min(#turbines, index + count - 1) do list[#list + 1] = turbines[i] end
      local title = #list > 0 and string.format("TURBINES %s - %s", list[1].label, list[#list].label) or "TURBINES"
      drawTurbines(cv, list, title)
      index = index + count
      if not pcall(cvFlush, cv, m.p) then m.canvas = nil end
    end
  end
end

-- the computer's own screen: a short summary
local function drawTerminal()
  term.setBackgroundColour(colours.black)
  term.clear()
  term.setCursorPos(1, 1)
  print("brcontrol " .. VERSION .. " - reactor + turbine controller")
  print("")
  print("Reactor:  " .. (R.ok and ((R.active and "online" or "offline") .. ", rods " .. dec(rods or 0, 1) .. "%") or "not connected"))
  print("Steam:    " .. commas(R.steamMade or 0) .. " made / " .. commas(demand) .. " wanted mB/t")
  print("Water:    " .. commas(R.water or 0) .. " / " .. commas(R.waterMax or 0) .. " mB")
  print("Control:  " .. controlNote)
  print("Power:    " .. commas(totals.rf or 0) .. " RF/t")
  print(string.format("Turbines: %d running, %d standby, %d offline", totals.running or 0, totals.standby or 0, totals.offline or 0))
  print("Monitors: " .. #monitors)
  print("")
  print("Press Q to stop (the reactor keeps its rods).")
end

