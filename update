-- update: installs the newest version of this computer's program (brcontrol, stockkeep or
-- dashboard, whichever its startup is) from GitHub, then reboots.
-- ComputerCraft 1.63.
--
--   update            newest version, this computer
--   update <commit>   that version (a commit id from GitHub), this computer
--   update all        every controller that reports to the brlink relay updates itself to the
--                     newest version within a few seconds (needs a brlink.key file here)
--
-- Only brcontrol runs "update <commit>" by itself when the relay passes on an "update all";
-- stockkeep and dashboard computers are updated by typing update (or update <commit>) on them.

local REPO = "landonracer109/BigReactors-CC"
local RELAY = "https://brlink.tailbdc4d5.ts.net"
local TARGET = "startup"
local KNOWN = { brcontrol = true, stockkeep = true, dashboard = true }
local args = { ... }

-- Which program this computer runs: the name on the first line of its startup ("-- stockkeep: ...").
local function installedProgram()
  local h = fs.open(TARGET, "r")
  if not h then return nil end
  local first = h.readLine() or ""
  h.close()
  local name = first:match("^%-%-%s*(%w+)%s*:")
  return name and KNOWN[name] and name or nil
end
local PROGRAM = installedProgram() or "brcontrol"
local SHA_FILE = PROGRAM .. ".sha"

local function fetch(url)
  local r = http.get(url)
  if not r then return nil end
  local text = r.readAll()
  r.close()
  return text
end

-- The newest commit on GitHub (asking the API avoids raw.githubusercontent's few-minute cache).
local function newestCommit()
  local json = fetch("https://api.github.com/repos/" .. REPO .. "/commits/master")
  return json and json:match('"sha"%s*:%s*"(%x+)"')
end

if not http then
  print("The http API is off on this server.")
  return
end

local sha = args[1]
if sha == nil or sha == "all" then
  write("Asking GitHub for the newest version... ")
  sha = newestCommit()
  if not sha then
    print("no answer. Try again in a minute.")
    return
  end
  sha = sha:sub(1, 7)
  print(sha)
end

if args[1] == "all" then
  local h = fs.open("brlink.key", "r")
  if not h then
    print("No brlink.key file on this computer, so the relay won't take the request.")
    return
  end
  local key = (h.readAll() or ""):gsub("%s", "")
  h.close()
  -- the key goes on the first line: CC 1.63 can't send headers with a POST
  local r = http.post(RELAY .. "/command", key .. "\n" .. textutils.serialize({ update = sha }))
  if not r then
    print("The relay refused it (wrong key?) or isn't reachable.")
    return
  end
  r.close()
  print("Sent. Every controller updates to " .. sha .. " within a few seconds,")
  print("and shows it on its screen after it restarts.")
  print("Watch them on " .. RELAY)
  return
end

if not sha:match("^%x+$") then
  print("Usage: update | update <commit> | update all")
  return
end

write("Downloading " .. PROGRAM .. " " .. sha .. "... ")
local code = fetch("https://raw.githubusercontent.com/" .. REPO .. "/" .. sha .. "/" .. PROGRAM)
if not code or not code:find(PROGRAM, 1, true) then
  print("failed. Nothing was changed.")
  return
end
if not loadstring(code, PROGRAM) then
  print("it doesn't load. Nothing was changed.")
  return
end
print("ok")

local h = fs.open(TARGET, "w")
h.write(code)
h.close()
h = fs.open(SHA_FILE, "w")
h.write(sha)
h.close()
print("Installed as " .. TARGET .. ". Restarting...")
sleep(1)
os.reboot()
