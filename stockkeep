-- item ids, learned by name from what's in AE (and remembered)

local ids = {}   -- name -> { id, dmg }

local function loadIds()
  local h = fs.open(IDS_FILE, "r")
  if not h then return end
  local t = textutils.unserialize(h.readAll() or "")
  h.close()
  if type(t) == "table" then ids = t end
end

local function saveIds()
  local h = fs.open(IDS_FILE, "w")
  if h then h.write(textutils.serialize(ids)); h.close() end
end

-- the list itself: stockkeep.list once it has been edited, the defaults until then
local LIST_FILE = "stockkeep.list"
local LIST = {}

local function saveList()
  local out = {}
  for _, e in ipairs(LIST) do
    out[#out + 1] = { name = e.name, keep = e.keep, tier = e.tier, how = e.how, from = e.from, per = e.per, side = e.side }
  end
  local h = fs.open(LIST_FILE, "w")
  if h then h.write(textutils.serialize(out)); h.close() end
end

local function loadList()
  local h = fs.open(LIST_FILE, "r")
  local t = nil
  if h then t = textutils.unserialize(h.readAll() or ""); h.close() end
  LIST = {}
  for _, e in ipairs(type(t) == "table" and t or DEFAULTS) do
    LIST[#LIST + 1] = { name = e.name, keep = e.keep, tier = e.tier, how = e.how, from = e.from, per = e.per or 1, side = e.side }
  end
end

local wanted, byName = {}, {}
local function reindex()
  wanted, byName = {}, {}
  for _, e in ipairs(LIST) do
    wanted[e.name] = true
    byName[e.name] = e
    if e.from then wanted[e.from] = true end
  end
end

local function scanIds()
  local all = try(ae, "getAvailableItems")
  if type(all) ~= "table" then return end
  local changed = false
  for _, s in pairs(all) do
    if type(s) == "table" and s.name and wanted[s.name] then
      local known = ids[s.name]
      if not known or known.id ~= s.id or known.dmg ~= s.dmg or known.max ~= s.maxSize then
        ids[s.name] = { id = s.id, dmg = s.dmg, max = s.maxSize }
        changed = true
      end
    end
  end
  if changed then saveIds() end
end

local function count(name)
  local i = ids[name]
  if not i then return nil end
  return tonumber(try(ae, "countOfItemType", i.id, i.dmg)) or 0
end

-- Moves n of an item from AE into the chest on side `dir` of the ME block, one stack per call.
-- (OpenPeripherals puts a whole request into one empty slot, past the 64 a slot holds, and the
-- chest throws the extra away; a stack at a time never overfills a slot.) Returns how many moved.
local function sendTo(id, n, dir)
  local per = math.max(1, math.min(tonumber(id.max) or 64, 64))
  local moved = 0
  while moved < n do
    local ask = math.min(per, n - moved)
    local got = tonumber(try(ae, "extractItem", { id = id.id, dmg = id.dmg, qty = ask }, dir)) or 0
    moved = moved + math.max(0, got)
    if got < ask then break end   -- the chest is full (or AE ran out)
  end
  return moved
end

