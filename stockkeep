-- main loop

loadIds()
loadList()
loadPages()
reindex()
findAE()
if not ae then
  print("No ME block found. Put a wired modem on an ME Interface (and this computer), right-click")
  print("both so they turn red, then run stockkeep again.")
  return
end
scanIds()

-- Two tasks side by side. CC 1.63 throws away every event that arrives while a program waits for a
-- peripheral call's answer; AE calls are slow, so a single loop missed many monitor taps (and
-- could lose its own timer). parallel hands each event to both tasks: the screen task always
-- hears a tap, even while the work task is waiting on AE.

-- the work: a heartbeat timer, started again only after the work is done, so it can't fire
-- (and be lost) during this task's own AE calls
local function work()
  local lastScan = os.clock()
  local lastStep, lastFlow = -math.huge, -math.huge
  while true do
    if not ae then findAE() end
    local redraw = not ae
    if ae then
      local now = os.clock()
      local before = lastWork
      if now - lastStep >= CFG.check then
        redraw = true
        if now - lastScan >= CFG.rescan then pcall(scanIds); lastScan = now end
        local ok, err = pcall(step)
        if not ok then lastWork = "error: " .. tostring(err) end
        lastStep = os.clock()
        lastFlow = -math.huge   -- send right after a check, so the counts are fresh
      end
      if os.clock() - lastFlow >= CFG.flowCheck then
        local ok, err = pcall(flow)
        if not ok then lastWork = "error: " .. tostring(err) end
        lastFlow = os.clock()
      end
      if lastWork ~= before then redraw = true end
    end
    if settleList() then redraw = true end
    if redraw then drawAll() end
    local timer = os.startTimer(1)
    repeat local _, id = os.pullEventRaw("timer") until id == timer
  end
end

-- the screen: taps, peripherals coming and going, and q to stop
local function screen()
  while true do
    local event, p1, p2, p3 = os.pullEventRaw()
    if event == "monitor_touch" then
      local ok, changed = pcall(touch, p1, p2, p3)
      if not ok then lastWork = "error: " .. tostring(changed) end
      if not ok or changed then drawAll() end
    elseif event == "peripheral" or event == "peripheral_detach" then
      findAE()
    elseif (event == "key" and p1 == keys.q) or event == "terminate" then
      return
    end
  end
end

drawAll()
parallel.waitForAny(work, screen)
for _, e in ipairs(LIST) do if e.how == "redstone" then rs.setOutput(e.side, false) end end
term.setBackgroundColour(colours.black); term.clear(); term.setCursorPos(1, 1)
print("stockkeep stopped (redstone outputs off).")
