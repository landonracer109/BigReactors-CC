-- helpers


local function commas(n)
  local s = tostring(math.floor(math.abs(n) + 0.5))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  if out:sub(1, 1) == "," then out = out:sub(2) end
  return (n < 0 and "-" or "") .. out
end

-- 12,500 -> "12.5k" above 9,999, so the HAVE / KEEP column stays narrow
local function compact(n)
  if math.abs(n) < 10000 then return commas(n) end
  local k = math.floor(n / 100 + 0.5) / 10
  if k >= 1000 then return math.floor(k / 100 + 0.5) / 10 .. "M" end
  return k .. "k"
end

local function try(p, method, ...)
  if not p or not p[method] then return nil end
  local ok, v = pcall(p[method], ...)
  if ok then return v end
  return nil
end

