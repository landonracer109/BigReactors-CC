-- stockkeep: keeps your AE stock of important items topped up. ComputerCraft 1.63 +
-- OpenPeripherals (Applied Energistics rv14).
--
-- Each item on the list below has a target amount and a way to make it:
--   craft      ask AE to craft it (needs a pattern)
--   smelt      send its input to your smelting Ender Chest
--   pulverize  send its input to your pulverizing Ender Chest
--   redstone   turn a redstone output on while it's low (replaces a level emitter, e.g. for
--              Induction Smelters fed by export buses)
--   watch      just show it (and how long it's been low)
-- It works up the tiers: lower tiers are refilled first, so the things above them find their
-- parts in stock and craft at full speed instead of one at a time.
--
-- Setup: a wired modem on an ME Interface (or another ME block) and on this computer, both
-- turned red. Put a smelting and a pulverizing Ender Chest (same colours as your machines' input
-- chests) touching that ME block, and set CFG.smeltChest / CFG.pulverizeChest to their side of it.
-- Optional: a wired modem on the ME Controller, so crafts follow AE's own job list (how many are
-- left, finished, or waiting on ingredients) instead of guessing from the stock counts.
-- Items are found by their name; one of each has to have been in AE once (it remembers them).
--
-- Editing: attach an Advanced Monitor to this computer. Tap - / + to change an amount, the method
-- to cycle it (craft, smelt, pulverize, watch, redstone side), the tier to cycle 1-9, and x twice
-- to remove. To add an item, put it in slot 1 of a chest on top of this computer (and, to smelt or
-- pulverize it, its input in slot 2), then tap "Add from chest". Changes are saved in
-- stockkeep.list; the list below is only the starting point.
--
-- Recipes checked against this pack (incl. Tomo's MineTweaker scripts): processors are smelted
-- from their assemblies, Silicon from Certus Quartz Dust (or crafted from 8 Galacticraft Raw
-- Silicon), Graphite from Coal, ingots from pulverized dust, dust from ore (2 each). Never smelt
-- raw yellorite: in this pack it turns into Atomic Science uranium.

local VERSION = "v37"   -- shown on screen; goes up by one with every release

local CFG = {
  check         = 30,        -- seconds between checks
  smeltChest    = "up",      -- side of the ME block the smelting Ender Chest is on
  pulverizeChest = "down",   -- side of the ME block the pulverizing Ender Chest is on
  craftBatch    = 256,       -- most of one item asked for in one crafting request
  overAlert     = 1000,      -- a Needs monitor also lists rows this far over their target
  craftAhead    = 1024,      -- with a controller: keep asking (a chunk per check) while AE has fewer than this queued
  sendBatch     = 1728,      -- most of one item sent per look (27 stacks: a whole Ender Chest)
  flowCheck     = 5,         -- seconds between sends for smelt all / pulverize all
  trip          = 60,        -- seconds: a sent batch counts as still at the machines at least this long
  quiet         = 15,        -- ... and after that until nothing has arrived for this many seconds
  stuckAfter    = 600,       -- seconds: sent items that haven't come back by then = a problem
  backoff       = 1800,      -- seconds before a stuck or refused craft is asked for again
  startDelay    = 60,        -- seconds after start before anything is crafted or sent (AE loading)
  settle        = 20,        -- seconds after the last tap before the list re-sorts and an edited row starts sending
  dropWait      = 300,       -- seconds to wait after AE dropped a craft three times running
  rescan        = 600,       -- seconds between looking up item names in AE
  addChest      = "top",     -- side of this computer with the chest used to add items
}

