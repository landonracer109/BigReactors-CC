-- the work

local sent = {}       -- name -> what is out: craft requests, or input at the machines for smelt/pulverize
local lowSince = {}   -- name -> os.clock() when it first went below target
local status = {}     -- name -> text
local lastWork = ""

-- AE's crafting jobs, from the ME Controller: "id:dmg" -> how many are still to be made.
-- (AE1 lists every request still running.) nil without a controller.
local function aeJobs()
  if not controller then return nil end
  local list = try(controller, "getJobList")
  if type(list) ~= "table" then return nil end
  local jobs = {}
  for _, j in pairs(list) do
    if type(j) == "table" and j.id then
      local key = j.id .. ":" .. (j.dmg or 0)
      jobs[key] = (jobs[key] or 0) + (tonumber(j.qty) or 0)
    end
  end
  return jobs
end

-- Sends input for a smelt/pulverize item; returns a status text.
local passedOn = {}   -- name -> how many of it this program has sent on to a machine, ever
local sentTotal = {}  -- name -> how many smelt all / pulverize all has sent since the program started
local vanished = {}   -- name -> AE jobs in a row that left the list with nothing made

local function process(e, have, short, now)
  -- Several batches can be out at once, so a big furnace line is kept busy. The chest is the
  -- limit (nothing goes in while it's full); on top of that, only what the target still needs
  -- beyond what is already at the machines is sent. Runs every CFG.flowCheck seconds.
  local s = sent[e.name]
  if not s then s = { out = 0, lastHave = have, unanswered = 0 }; sent[e.name] = s end
  -- any rise means the machines are delivering (the total may never rise by a whole batch when
  -- something else uses the item meanwhile, like crafting assemblies pulling the dust)
  if have > s.lastHave then s.waitingSince, s.unanswered, s.lastRise = nil, 0, now end
  s.lastHave = have
  if s.retryAt then
    if now < s.retryAt then
      return "STUCK: " .. displayName(e.from) .. " never came back; retry in " .. math.ceil((s.retryAt - now) / 60) .. " min"
    end
    s.retryAt, s.waitingSince, s.unanswered, s.out = nil, nil, 0, 0
  end
  if s.waitingSince and now - s.waitingSince > CFG.stuckAfter then
    s.retryAt = now + CFG.backoff
    return "STUCK: " .. commas(s.unanswered) .. " " .. displayName(e.from) .. ", none back in " .. math.floor((now - s.waitingSince) / 60) .. " min"
  end
  -- still at the machines: everything sent since this row last caught up, less everything that
  -- came back since then (counting what was passed straight on to the next machine). It stays
  -- counted while deliveries keep coming, however long the furnace queue is; once nothing has
  -- arrived for CFG.quiet seconds (and the last send is over CFG.trip seconds old) the machines
  -- are done and whatever didn't show up went to other uses.
  local inFlight = 0
  if (s.out or 0) > 0 then
    local arrived = (have - s.base + (passedOn[e.name] or 0) - s.basePassed) / e.per
    inFlight = math.max(0, s.out - math.max(0, arrived))
    local delivering = s.lastRise and now - s.lastRise < CFG.quiet
    -- forget it only once deliveries have started and then stopped: a long queue ahead of it
    -- (ores first) can take minutes before anything arrives, and that is not "done"
    local started = s.lastRise and s.lastRise >= s.windowStart
    if inFlight <= 0 or (now - s.lastSend >= CFG.trip and started and not delivering) then s.out, inFlight = 0, 0 end
  end
  local inFlightText = inFlight > 0 and ("processing " .. commas(math.ceil(inFlight * e.per))) or nil
  if not e.from then return "no input: use " .. e.how .. " all, or re-add it" end
  local fromId = ids[e.from]
  if not fromId then return "needs " .. displayName(e.from) .. " (never seen)" end
  local need = math.ceil(short / e.per) - math.ceil(inFlight)
  if need <= 0 then return inFlightText end
  -- a raw material on the list (how = "watch") is only spent down to its own target;
  -- intermediates (dust on its way to ingots) can be used up, their own rule refills them
  local available = count(e.from) or 0
  local fromEntry = byName[e.from]
  if fromEntry and fromEntry.how == "watch" then available = available - fromEntry.keep end
  local n = math.min(need, available, CFG.sendBatch)
  if n <= 0 then return inFlightText or ("short, no " .. displayName(e.from)) end
  local dir = e.how == "smelt" and CFG.smeltChest or CFG.pulverizeChest
  local moved = tonumber(sendTo(fromId, n, dir)) or 0
  if moved <= 0 then return inFlightText or ("waiting: " .. e.how .. " chest full") end
  if s.out == 0 then s.base, s.basePassed, s.windowStart = have, passedOn[e.name] or 0, now end
  s.out, s.lastSend = s.out + moved, now
  s.waitingSince = s.waitingSince or now
  s.unanswered = s.unanswered + moved
  passedOn[e.from] = (passedOn[e.from] or 0) + moved
  lastWork = "sent " .. commas(moved) .. " " .. displayName(e.from) .. " to " .. e.how
  return "processing " .. commas(math.ceil((inFlight + moved) * e.per))
end

-- smelt all / pulverize all: input-driven, like an export bus. Everything above the reserve
-- (keep) goes to the machine chest, a stack per call until the chest is full; run often.
local function flow()
  if os.clock() < CFG.startDelay then return end   -- AE may still be loading (see step)
  local rows = {}   -- a copy: the screen task can change the list while this waits on AE
  for i, e in ipairs(LIST) do rows[i] = e end
  for _, e in ipairs(rows) do
    local editing = e.editedAt and os.clock() - e.editedAt < CFG.settle
    if editing and (e.how == "smelt all" or e.how == "pulverize all" or e.how == "smelt" or e.how == "pulverize") then
      -- just added or changed: nothing goes out until the taps are done
      status[e.name] = "starts in " .. math.ceil(CFG.settle - (os.clock() - e.editedAt)) .. " s"
    elseif (e.how == "smelt all" or e.how == "pulverize all") and ids[e.name] then
      local have = count(e.name) or 0
      local extra = have - e.keep
      if extra <= 0 then
        if not (status[e.name] or ""):find("^sent") then status[e.name] = "ok" end
      else
        local dir = e.how == "smelt all" and CFG.smeltChest or CFG.pulverizeChest
        local moved = sendTo(ids[e.name], math.min(extra, CFG.sendBatch), dir)
        if moved > 0 then
          passedOn[e.name] = (passedOn[e.name] or 0) + moved
          sentTotal[e.name] = (sentTotal[e.name] or 0) + moved
          status[e.name] = "sent " .. commas(sentTotal[e.name]) .. " so far"
          have = have - moved
          lastWork = "sent " .. commas(moved) .. " " .. displayName(e.name) .. " to " .. e.how:sub(1, -5)
        else
          status[e.name] = "waiting: " .. e.how:sub(1, -5) .. " chest full"
        end
      end
      e.have = have
    elseif (e.how == "smelt" or e.how == "pulverize") and ids[e.name] then
      -- made to a target: keep enough input at the machines to cover what's short
      local have = count(e.name) or 0
      if have >= e.keep then
        sent[e.name] = nil
        status[e.name] = "ok"
      else
        local ok, st = pcall(process, e, have, e.keep - have, os.clock())   -- one bad row mustn't stop the rest
        status[e.name] = ok and st or ("error: " .. tostring(st))
      end
      e.have = have
    end
  end
end

local function byTier(a, b) if a.tier ~= b.tier then return a.tier < b.tier end return a.name < b.name end

local function step()
  local now = os.clock()
  local jobs = aeJobs()   -- nil without a controller: crafts are then judged by the counts
  local craftTier = nil   -- crafts only for the lowest tier still short
  -- work through a sorted copy: the list on the screen holds still while it's being edited
  local order = {}
  for i, e in ipairs(LIST) do order[i] = e end
  table.sort(order, byTier)
  -- Count everything first. Right after a server restart (or an update) AE often isn't loaded
  -- yet and reports 0 of everything; crafting against those zeros asked for a whole batch of
  -- items that were already there, once per reboot. So nothing happens in the first
  -- CFG.startDelay seconds, nor while every listed item reads 0.
  local counts, nonzero = {}, 0
  for _, e in ipairs(order) do
    counts[e] = count(e.name)
    if (counts[e] or 0) > 0 then nonzero = nonzero + 1 end
  end
  if now < CFG.startDelay or (nonzero == 0 and #order >= 3) then
    local why = now < CFG.startDelay and ("starting up (" .. math.ceil(CFG.startDelay - now) .. " s)") or "AE reads empty: waiting"
    for _, e in ipairs(order) do status[e.name] = why end
    lastWork = why
    return false
  end
  for _, e in ipairs(order) do
    local have = counts[e]
    if have == nil then
      status[e.name] = "never seen: put one in AE"
      if e.how == "redstone" then rs.setOutput(e.side, false) end
    else
      local short = e.keep - have
      if short > 0 then lowSince[e.name] = lowSince[e.name] or now else lowSince[e.name] = nil end
      if e.how == "smelt all" or e.how == "pulverize all" then
        have = e.have or have   -- flow() sends these every CFG.flowCheck seconds and keeps the count
      elseif e.how == "redstone" then
        rs.setOutput(e.side, short > 0)
        status[e.name] = short > 0 and ("ON (" .. e.side .. ")") or "ok"
      elseif short <= 0 then
        status[e.name] = "ok"
        sent[e.name] = nil
      elseif e.how == "craft" and e.editedAt and now - e.editedAt < CFG.settle then
        status[e.name] = "starts in " .. math.ceil(CFG.settle - (now - e.editedAt)) .. " s"   -- still being set
      elseif e.how == "craft" then
        local i = ids[e.name]
        local key = i.id .. ":" .. i.dmg
        if jobs then
          -- With a controller: AE's job list says how many are still to be made. Ask only for what
          -- that doesn't already cover, a chunk (CFG.craftBatch) at a time, with the next chunk
          -- queued while one runs, so the machines never wait and a row ends at most a chunk's
          -- worth of machine contents over its target.
          local r = sent[e.name] or {}
          sent[e.name] = r
          local queued = jobs[key] or 0
          if queued ~= (r.lastQ or 0) then
            if queued < (r.lastQ or 0) or not r.movedAt then r.movedAt = now end
            r.lastQ = queued
          end
          if queued == 0 then r.movedAt = nil end
          local waiting = queued > 0 and r.movedAt and now - r.movedAt > CFG.stuckAfter
          local need = e.keep - have - queued
          if r.retryAt and now >= r.retryAt then r.retryAt, r.dropped = nil, nil end
          if r.retryAt then
            status[e.name] = (r.dropped and "AE dropped it 3 times (pattern?); again in " or "STUCK: no pattern? retry in ") .. math.ceil((r.retryAt - now) / 60) .. " min"
          elseif waiting then
            -- AE keeps the job and finishes it once the ingredients turn up; the tiers above go on
            status[e.name] = "AE waiting on ingredients (" .. commas(queued) .. " left)"
          elseif need > 0 and queued < CFG.craftAhead and not (craftTier and e.tier > craftTier) then
            craftTier = craftTier or e.tier
            -- chunks of CFG.craftBatch until CFG.craftAhead are queued (or the need is covered)
            local asked = 0
            while need > 0 and queued + asked < CFG.craftAhead do
              local n = math.min(need, CFG.craftBatch, CFG.craftAhead - queued - asked)
              if not pcall(ae.requestCrafting, { id = i.id, dmg = i.dmg, qty = n }) then break end
              asked, need = asked + n, need - n
            end
            -- AE1 lists a job the moment it takes it on: look right away
            local after = asked > 0 and aeJobs() or nil
            if after and (after[key] or 0) > queued then
              vanished[e.name] = 0
              r.lastQ, r.movedAt = after[key], now
              status[e.name] = commas(after[key]) .. " left"
              lastWork = "asked AE for " .. commas(asked) .. " " .. displayName(e.name)
            else
              -- not taken on (no pattern?): try again next check; three times in a row, wait a bit
              vanished[e.name] = (vanished[e.name] or 0) + 1
              if vanished[e.name] >= 3 then
                vanished[e.name] = 0
                r.retryAt, r.dropped = now + CFG.dropWait, true
              end
              status[e.name] = "AE didn't take it (pattern?)"
              craftTier = queued > 0 and craftTier or nil
            end
          elseif queued > 0 then
            craftTier = craftTier or e.tier
            status[e.name] = commas(queued) .. " left"
          elseif craftTier and e.tier > craftTier then
            status[e.name] = "waiting for tier " .. craftTier
          else
            status[e.name] = "low"
          end
        else
          local c = sent[e.name]
          if c and not c.amount and not c.retryAt then sent[e.name], c = nil, nil end   -- (state from the controller path)
          local i = ids[e.name]
          local left = jobs and jobs[i.id .. ":" .. i.dmg]   -- AE's own count still to make
          if jobs and left and not c then
            -- a job for it already (asked for by hand, or before a restart): follow that one
            c = { amount = left, since = now, startCount = have, passedAtStart = passedOn[e.name] or 0, adopted = true }
            sent[e.name] = c
          end
          if c and c.retryAt then
            if now >= c.retryAt then sent[e.name], c = nil, nil end
          elseif c and jobs then
            -- with a controller: AE's job list says it all
            -- (AE1 lists every request the moment it's made, so gone from the list = finished, even
            -- when the stock didn't rise because other crafts used it up as fast as it was made.)
            local made = have + (passedOn[e.name] or 0) - (c.passedAtStart or 0) - c.startCount
            if not left then
              vanished[e.name] = (c.left or made > 0) and 0 or (vanished[e.name] or 0) + 1   -- c.left: AE had listed it
              if vanished[e.name] >= 3 then
                -- three jobs in a row gone with nothing to show: maybe AE drops it; wait a bit
                vanished[e.name] = 0
                c.retryAt, c.dropped = now + CFG.dropWait, true
              else
                sent[e.name], c = nil, nil   -- finished; asked again below if still short
              end
            else
              if left < (c.left or math.huge) then c.left, c.since = left, now end
              c.waiting = now - c.since > CFG.stuckAfter   -- nothing made for a while: missing ingredients
            end
          elseif c then
            -- without one: done once the stock rose by it, counting what was sent straight on to a
            -- machine (assemblies going to the furnaces). A craft that keeps delivering isn't stuck,
            -- however long it takes; one that never delivers (no pattern, missing materials) backs
            -- off and stops holding up the tiers above it.
            local made = have + (passedOn[e.name] or 0) - (c.passedAtStart or 0) - c.startCount
            if made > (c.made or 0) then c.made, c.since = made, now end
            if made >= c.amount then
              sent[e.name], c = nil, nil
            elseif now - c.since > CFG.stuckAfter then
              c.retryAt = now + CFG.backoff
            end
          end
          if c and c.retryAt then
            status[e.name] = (c.dropped and "AE dropped it 3 times (pattern?); again in " or "STUCK: no pattern or materials? retry in ") .. math.ceil((c.retryAt - now) / 60) .. " min"
          elseif c and c.waiting then
            -- AE keeps the job and finishes it once the ingredients turn up; the tiers above go on
            status[e.name] = "AE waiting on ingredients (" .. commas(c.left) .. " left)"
          elseif c then
            craftTier = craftTier or e.tier
            if c.left then
              status[e.name] = commas(c.left) .. "/" .. commas(c.amount) .. " left"   -- still to make / asked for (short: the computer's screen is narrow)
            else
              status[e.name] = "crafting " .. commas(c.amount) .. ((c.made or 0) > 0 and (", " .. commas(c.made) .. " done") or "")
            end
          elseif craftTier and e.tier > craftTier then
            status[e.name] = "waiting for tier " .. craftTier
          else
            craftTier = e.tier
            local n = math.min(short, CFG.craftBatch)
            if pcall(ae.requestCrafting, { id = i.id, dmg = i.dmg, qty = n }) then
              sent[e.name] = { amount = n, since = now, startCount = have, passedAtStart = passedOn[e.name] or 0 }
              if jobs then   -- AE lists a job the moment it takes it on: look once, right away
                local now2 = aeJobs()
                sent[e.name].left = now2 and now2[i.id .. ":" .. i.dmg]
              end
              status[e.name] = "crafting " .. commas(n)
              lastWork = "asked AE for " .. commas(n) .. " " .. displayName(e.name)
            else
              sent[e.name] = { amount = n, since = now, startCount = have, retryAt = now + CFG.backoff }
              status[e.name] = "craft request failed (no pattern?)"
              craftTier = nil   -- a refused request doesn't hold up the tiers above
            end
          end
        end
      elseif e.how == "smelt" or e.how == "pulverize" then
        have = e.have or have   -- flow() sends these every CFG.flowCheck seconds and keeps the count
      else
        status[e.name] = "low"
      end
      e.have = have
    end
  end
end

