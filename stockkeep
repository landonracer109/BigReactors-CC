-- the monitor: the whole list, edited by touch

local LADDER = { 0, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 100000, 250000, 500000, 1000000 }
local METHODS = { "craft", "smelt", "pulverize", "smelt all", "pulverize all", "watch", "rs:left", "rs:right", "rs:front", "rs:back", "rs:top", "rs:bottom" }
local ui = { hits = {}, message = "Tap - / + to change amounts, the method or tier to cycle them.", confirm = nil, confirmAt = 0,
             editedAt = -math.huge }
local SETTLE = 20   -- seconds after the last change before the list sorts itself again

-- The screen groups rows by method, A-Z by name inside each group. (The checks work through
-- the list by tier; this order is only for finding things.)
local METHOD_ORDER = { pulverize = 1, ["pulverize all"] = 2, smelt = 3, ["smelt all"] = 4, craft = 5, redstone = 6, watch = 7 }
local function byMethod(a, b)
  local ma, mb = METHOD_ORDER[a.how] or 8, METHOD_ORDER[b.how] or 8
  if ma ~= mb then return ma < mb end
  local na, nb = displayName(a.name), displayName(b.name)
  if na ~= nb then return na < nb end
  return a.name < b.name
end

-- Each monitor shows its own page (monitor name -> page), remembered in stockkeep.pages.
-- A monitor without a saved page starts on its place in line: the first one page 1, and so on.
local PAGES_FILE = "stockkeep.pages"
ui.pages, ui.hits, ui.rows, ui.shown = {}, {}, {}, {}
local function loadPages()
  local h = fs.open(PAGES_FILE, "r")
  if not h then return end
  local t = textutils.unserialize(h.readAll() or "")
  h.close()
  if type(t) == "table" then ui.pages = t end
end
local function savePages()
  local h = fs.open(PAGES_FILE, "w")
  if h then h.write(textutils.serialize(ui.pages)); h.close() end
end

-- Sorts the screen's list by method and name, unless something was changed in the last SETTLE
-- seconds (so a row doesn't jump away while you're still setting it). True if the order changed.
local function settleList()
  if os.clock() - ui.editedAt < SETTLE then return false end
  local before = {}
  for i, e in ipairs(LIST) do before[i] = e end
  table.sort(LIST, byMethod)
  local moved = false
  for i, e in ipairs(LIST) do if before[i] ~= e then moved = true end end
  -- the monitor it was changed on follows the row to its new page
  local on = ui.editedOn
  if moved and ui.edited and on and ui.rows[on] then
    for i, e in ipairs(LIST) do if e == ui.edited then ui.pages[on] = math.ceil(i / ui.rows[on]); savePages() end end
  end
  ui.edited, ui.editedOn = nil, nil
  return moved
end

local function methodLabel(e)
  if e.how == "redstone" then return "rs:" .. (e.side or "?") end
  return e.how
end

local function stepKeep(keep, dir)
  if dir > 0 then
    for _, v in ipairs(LADDER) do if v > keep then return v end end
    return keep
  end
  for i = #LADDER, 1, -1 do if LADDER[i] < keep then return LADDER[i] end end
  return 0
end

local function button(dev, x, y, label, bg, action, e)
  dev.setCursorPos(x, y)
  dev.setBackgroundColour(bg)
  dev.setTextColour(colours.white)
  dev.write(label)
  dev.setBackgroundColour(colours.black)
  ui.drawing[#ui.drawing + 1] = { x1 = x, x2 = x + #label - 1, y = y, action = action, e = e }
end

local monitorScale = {}   -- monitor -> text size chosen for it

-- The biggest text that still leaves room for every column (80 characters across: an 8-wide
-- monitor gets normal-size text, a 4-wide one the small size).
local function fitScale(m)
  local w0, h0 = m.getSize()
  local key = tostring(m)
  local known = monitorScale[key]
  if known and known.w == w0 and known.h == h0 then return end
  for _, s in ipairs({ 2, 1.5, 1, 0.5 }) do
    m.setTextScale(s)
    local w, h = m.getSize()
    if (w >= 80 and h >= 10) or s == 0.5 then
      local fw, fh = m.getSize()
      monitorScale[key] = { w = fw, h = fh }
      return
    end
  end
end

local function band(m, y, w, bg)
  m.setCursorPos(1, y)
  m.setBackgroundColour(bg)
  m.write(string.rep(" ", w))
end

local function drawMonitor(m, name, place)
  fitScale(m)
  local w, h = m.getSize()
  m.setBackgroundColour(colours.black)
  m.clear()
  ui.drawing = {}
  ui.hits[name] = ui.drawing   -- this monitor's buttons, for its taps
  -- header: a solid bar with the title and the controls
  band(m, 1, w, colours.blue)
  m.setCursorPos(2, 1); m.setTextColour(colours.yellow); m.write("STOCKKEEP")
  if COMMIT then m.setCursorPos(w - #COMMIT, 1); m.setTextColour(colours.lightBlue); m.write(COMMIT) end
  button(m, 13, 1, " Add from chest ", colours.green, "add")
  local rows = h - 4
  ui.rows[name] = rows
  local pages = math.max(1, math.ceil(#LIST / rows))
  local page = math.max(1, math.min(ui.pages[name] or place, pages))
  ui.shown[name] = page
  button(m, 31, 1, " < ", colours.grey, "prev")
  m.setCursorPos(35, 1); m.setBackgroundColour(colours.blue); m.setTextColour(colours.white); m.write(page .. "/" .. pages)
  button(m, 40, 1, " > ", colours.grey, "next")
  m.setBackgroundColour(colours.black)
  m.setCursorPos(2, 2); m.setTextColour(colours.lightGrey); m.write(ui.message:sub(1, w - 2))
  local nameW = math.max(10, w - 63)
  local cKeep, cHow, cTier, cBtn, cSt = nameW + 2, nameW + 16, nameW + 32, nameW + 36, nameW + 50
  -- column headings on a grey band
  band(m, 3, w, colours.grey)
  m.setTextColour(colours.white)
  m.setCursorPos(2, 3); m.write("ITEM"); m.setCursorPos(cKeep, 3); m.write("HAVE / KEEP"); m.setCursorPos(cHow, 3); m.write("HOW")
  m.setCursorPos(cTier, 3); m.write("T"); m.setCursorPos(cSt, 3); m.write("STATUS")
  m.setBackgroundColour(colours.black)
  local first = (page - 1) * rows + 1
  for i = first, math.min(#LIST, first + rows - 1) do
    local e, y = LIST[i], 4 + i - first
    m.setCursorPos(2, y); m.setTextColour(colours.white)
    local shown = displayName(e.name)
    m.write(#shown > nameW and (shown:sub(1, nameW - 1) .. ".") or shown)
    ui.drawing[#ui.drawing + 1] = { x1 = 2, x2 = nameW + 1, y = y, action = "name", e = e }
    m.setCursorPos(cKeep, y); m.setTextColour(colours.lightBlue)
    m.write((e.have and compact(e.have) or "?") .. " / " .. compact(e.keep))
    button(m, cHow, y, (" " .. methodLabel(e) .. string.rep(" ", 14)):sub(1, 15), colours.blue, "how", e)
    button(m, cTier, y, " " .. e.tier .. " ", colours.purple, "tier", e)
    button(m, cBtn, y, " - ", colours.grey, "less", e)
    button(m, cBtn + 4, y, " + ", colours.grey, "more", e)
    button(m, cBtn + 8, y, ui.confirm == e and "sure?" or " x ", colours.red, "remove", e)
    m.setCursorPos(cSt, y); m.setTextColour(statusColour(status[e.name]))
    m.write((status[e.name] or ""):sub(1, math.max(1, w - cSt + 1)))
  end
end

-- Advanced monitors in line order: ones touching the computer first, then by modem number
-- (monitor_0, monitor_1, ... in the order their modems were first switched on).
local function monitors()
  local list = {}
  for _, name in ipairs(peripheral.getNames()) do
    if peripheral.getType(name) == "monitor" then
      local m = peripheral.wrap(name)
      if m and m.isColour and m.isColour() then list[#list + 1] = { name = name, m = m } end
    end
  end
  local function rank(n) return tonumber(n:match("_(%d+)$")) or -1 end
  table.sort(list, function(a, b)
    if rank(a.name) ~= rank(b.name) then return rank(a.name) < rank(b.name) end
    return a.name < b.name
  end)
  return list
end

local function drawAll()
  pcall(drawTerm)
  for place, mon in ipairs(monitors()) do pcall(drawMonitor, mon.m, mon.name, place) end
end

-- The chest for adding items: on CFG.addChest (default on top of this computer).
local function chestStacks()
  local c = peripheral.wrap(CFG.addChest)
  if not c or not c.getAllStacks then return nil end
  local ok, all = pcall(c.getAllStacks)
  if not ok or type(all) ~= "table" then return nil end
  if all[0] ~= nil then          -- some versions count slots from 0
    local shifted = {}
    for k, v in pairs(all) do shifted[k + 1] = v end
    all = shifted
  end
  return all
end

local function addFromChest()
  local stacks = chestStacks()
  if not stacks then ui.message = "No chest on the " .. CFG.addChest .. " of this computer."; return end
  local item, input = stacks[1], stacks[2]
  if type(item) ~= "table" or not item.name or item.name == "empty" then
    ui.message = "Put the item in slot 1 of the chest (and its input in slot 2 to smelt or pulverize it)."
    return
  end
  if byName[item.name] then ui.message = item.name .. " is already on the list."; return end
  ids[item.name] = { id = item.id, dmg = item.dmg, max = item.maxSize }
  local e = { name = item.name, keep = 256, tier = 5, how = "craft", per = 1 }
  if type(input) == "table" and input.name and input.name ~= "empty" then
    ids[input.name] = { id = input.id, dmg = input.dmg, max = input.maxSize }
    e.from, e.how, e.tier = input.name, "smelt", 2
  end
  LIST[#LIST + 1] = e
  saveIds(); saveList(); reindex()
  ui.message = "Added " .. displayName(item.name) .. (e.from and (" (from " .. displayName(e.from) .. ")") or "") .. ". Set its amount with + and its method by tapping it."
end

local function touch(mon, x, y)
  for _, hit in ipairs(ui.hits[mon] or {}) do
    if y == hit.y and x >= hit.x1 and x <= hit.x2 then
      local e = hit.e
      if hit.action ~= "remove" then ui.confirm = nil end
      if hit.action ~= "name" and hit.action ~= "prev" and hit.action ~= "next" then ui.editedAt, ui.edited, ui.editedOn = os.clock(), e, mon end
      if hit.action == "add" then
        local n = #LIST
        addFromChest()
        if #LIST > n then   -- show the last page, where the new row is
          ui.edited = LIST[#LIST]
          ui.pages[mon] = math.ceil(#LIST / (ui.rows[mon] or 1)); savePages()
        end
      elseif hit.action == "name" then
        ui.message = displayName(e.name) .. (displayName(e.name) ~= e.name and ("  (internal name: " .. e.name .. ")") or "") .. (e.from and ("  from " .. displayName(e.from)) or "")
      elseif hit.action == "prev" or hit.action == "next" then
        local pages = math.max(1, math.ceil(#LIST / (ui.rows[mon] or 1)))
        local page = math.max(1, math.min(ui.shown[mon] or 1, pages)) + (hit.action == "next" and 1 or -1)
        ui.pages[mon] = math.max(1, math.min(page, pages)); savePages()
      elseif hit.action == "less" then e.keep = stepKeep(e.keep, -1); saveList()
      elseif hit.action == "more" then e.keep = stepKeep(e.keep, 1); saveList()
      elseif hit.action == "tier" then e.tier = e.tier % 9 + 1; saveList()
      elseif hit.action == "how" then
        if e.how == "redstone" then rs.setOutput(e.side, false) end
        local cur = methodLabel(e)
        local nextIdx = 1
        for i, mth in ipairs(METHODS) do if mth == cur then nextIdx = i % #METHODS + 1 end end
        local mth = METHODS[nextIdx]
        local wasAll = e.how == "smelt all" or e.how == "pulverize all"
        if mth:sub(1, 3) == "rs:" then e.how, e.side = "redstone", mth:sub(4) else e.how, e.side = mth, nil end
        local isAll = e.how == "smelt all" or e.how == "pulverize all"
        -- for smelt all / pulverize all the number is a reserve, almost always 0; the old amount
        -- comes back when tapping on to a method with a target
        if isAll and not wasAll then e.keepBefore, e.keep = e.keep, 0
        elseif wasAll and not isAll and e.keepBefore then e.keep, e.keepBefore = e.keepBefore, nil end
        if (e.how == "smelt" or e.how == "pulverize") and not e.from then
          ui.message = e.how .. " makes " .. e.name .. " to a target and needs its input (chest slot 2). Keep tapping for " .. e.how .. " all."
        else
          ui.message = e.name .. ": " .. methodLabel(e) .. "."
        end
        sent[e.name] = nil
        saveList()
      elseif hit.action == "remove" then
        if ui.confirm == e and os.clock() - ui.confirmAt < 5 then
          if e.how == "redstone" then rs.setOutput(e.side, false) end
          for i, other in ipairs(LIST) do if other == e then table.remove(LIST, i); break end end
          ui.confirm = nil
          saveList(); reindex()
          ui.message = "Removed " .. e.name .. "."
        else
          ui.confirm, ui.confirmAt = e, os.clock()
        end
      end
      return true
    end
  end
  return false
end

