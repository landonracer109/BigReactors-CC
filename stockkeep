function displayName(name)   -- (declared local above, near the work)
  local base = name:gsub("%.name$", "")
  local known = AE_NAMES[name] or AE_NAMES[base]
  if known then return known end
  -- any other untranslated key (tile.mod.thing / item.mod.thing): make a readable guess from it
  if base:find("^tile%.") or base:find("^item%.") then
    local words = {}
    for part in base:gmatch("[^%.]+") do words[#words + 1] = part end
    table.remove(words, 1)                                   -- "tile" / "item"
    while #words > 1 and words[#words]:find("^%d+$") do table.remove(words) end   -- "brOre.0"
    if #words > 1 then table.remove(words, 1) end            -- the mod's name
    local s = table.concat(words, " "):gsub("(%l)(%u)", "%1 %2"):gsub("_", " ")
    return (s:gsub("(%a)([%w]*)", function(a, b) return a:upper() .. b end))
  end
  -- "Mod:thing" keys (Calclavia's "Calclavia:dustSteel"): drop the mod, split the words, and put
  -- the kind last the way the game does ("Dust Steel" -> "Steel Dust")
  local rest = base:match("^[%w_]+:(.+)$")
  if rest then
    local s = rest:gsub("(%l)(%u)", "%1 %2"):gsub("_", " ")
    s = s:gsub("(%a)([%w]*)", function(a, b) return a:upper() .. b end)
    local kind, what = s:match("^(%a+) (.+)$")
    local kinds = { Dust = true, Ingot = true, Plate = true, Gear = true, Nugget = true, Ore = true, Block = true }
    if kind and kinds[kind] then s = what .. " " .. kind end
    return s
  end
  return name
end

local function statusColour(st)
  if not st then return colours.white end
  if st:find("STUCK") or st:find("never") or st:find("failed") or st:find("can't") then return colours.red end
  if st:find("waiting") then return colours.lightGrey end
  if st == "ok" then return colours.lime end
  return colours.white
end

-- A row counts as satisfied when it's at its target ("ok") or a smelt all / pulverize all row
-- is just passing things on ("sent N so far"); everything else needs something.
local function satisfied(e)
  local st = status[e.name] or ""
  return st == "ok" or st:find("^sent") ~= nil
end

local function drawTerm()
  local w, h = term.getSize()
  term.setBackgroundColour(colours.black)
  term.clear()
  term.setCursorPos(1, 1)
  term.setTextColour(colours.yellow)
  term.write("stockkeep " .. VERSION .. "  " .. (aeName or "no AE found") .. (controller and "" or "  (no controller)"))
  local low, ok = {}, 0
  for _, e in ipairs(LIST) do
    -- (same rule as a monitor in Needs mode)
    if satisfied(e) then ok = ok + 1 else low[#low + 1] = e end
  end
  term.setCursorPos(1, 2)
  term.setTextColour(colours.lightGrey)
  term.write(ok .. " of " .. #LIST .. " stocked. " .. lastWork)
  local y = 3
  for _, e in ipairs(low) do
    if y > h then break end
    local st = status[e.name] or ""
    term.setCursorPos(1, y); term.setTextColour(colours.white)
    local shown = displayName(e.name)
    term.write(#shown > 20 and (shown:sub(1, 19) .. ".") or shown)
    term.setCursorPos(22, y); term.setTextColour(colours.lightBlue)
    term.write((e.have and commas(e.have) or "?") .. "/" .. commas(e.keep))
    term.setCursorPos(36, y); term.setTextColour(statusColour(st))
    term.write(st:sub(1, math.max(1, w - 35)))
    y = y + 1
  end
end

